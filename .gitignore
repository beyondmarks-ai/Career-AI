# Ignore virtual environment folders
.venv/
env/

# .gitignore
.env
.streamlit/secrets.toml

# Ignore __pycache__ and bytecode
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/
*.log

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore local IDE settings
.idea/
.vercel/
.env.local
.env.*.local
.azure/
